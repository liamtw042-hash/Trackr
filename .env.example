# Firebase — from your Firebase project settings (console.firebase.google.com)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Anthropic — from console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Cloudinary — from cloudinary.com/console (free tier is enough for screenshots)
# 1. Sign up at cloudinary.com
# 2. Copy your Cloud Name from the dashboard home page
# 3. Go to Settings → Upload → "Add upload preset" → set Mode to "Unsigned" → save
# 4. Copy the preset name here
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
